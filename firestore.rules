rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // PIN認証で発行されたカスタムトークンの env クレームと
    // アクセス先パスの {env} が一致する場合のみ読み書きを許可する。
    // 未認証・PIN不一致のリクエストは全て拒否される。
    match /environments/{env}/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.env == env;
    }
  }
}
